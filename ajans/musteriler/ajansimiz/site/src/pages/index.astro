---
import '../styles/global.css';
import { site, waLink, telLink, mailLink, igLink } from '../site.config';

const title = `${site.brand} — Yerel işletmeler için web sitesi, uygulama, sosyal medya ve reklam`;
const description = 'Restoran, kafe, berber, klinik ve butikler için web sitesi, mobil uygulama, sosyal medya ve reklam tek yerden, günler içinde. WhatsApp\'tan ücretsiz dijital check-up isteyin.';

// Lucide ikon yolları (inline SVG, stroke 1.75)
const ic = {
  wa: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  menu: '<line x1="4" x2="20" y1="7" y2="7"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="17" y2="17"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  insta: '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  smartphone: '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  megaphone: '<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
  layout: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  phoneMissed: '<line x1="22" x2="16" y1="2" y2="8"/><line x1="16" x2="22" y1="2" y2="8"/><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  fileQ: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 13a2 2 0 1 1 2 2v1"/><path d="M12 19h.01"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  trend: '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
};
const I = (n: keyof typeof ic, cls = 'icon') => `<svg class="${cls}" viewBox="0 0 24 24" aria-hidden="true">${ic[n]}</svg>`;

const words = ['İşletmenizin', 'dijital', 'vitrini,', 'günler', 'içinde', 'hazır.'];
const sectors = ['Restoran', 'Kafe', 'Berber', 'Kuaför', 'Güzellik salonu', 'Klinik', 'Butik', 'Usta ve servis', 'Pastane', 'Diş hekimi', 'Fırın', 'Spor salonu'];

const pains = [
  { icon: 'fileQ', d: 'Instagram\'dan gelen müşteri menüyü bulamıyor.', s: 'Profildeki link bir PDF\'e ya da hiçbir yere gitmiyor. Telefonda açılan, menüsü, saatleri ve konumu tek ekranda olan bir sayfa kuruyoruz.' },
  { icon: 'search', d: 'Google\'da "yakınımdaki kafe" diye arayınca siz yoksunuz.', s: 'Google İşletme Profili eksik, site yok ya da eski. Profili düzenliyor, siteyi şehir ve hizmet adıyla aranacak şekilde hazırlıyoruz.' },
  { icon: 'phoneMissed', d: 'Yoğun saatte gelen aramalar ve mesajlar kaçıyor.', s: 'Sık sorulan sorulara WhatsApp ve Instagram\'da otomatik ilk cevap, randevu ya da rezervasyon için tek dokunuşluk yol kuruyoruz.' },
];

const steps = [
  { t: '10 dakikalık görüşme', d: 'WhatsApp\'tan yazın ya da arayın. İşletmenizi, müşterinizi ve derdinizi dinliyoruz.' },
  { t: '3 tasarım yönü', d: 'Size özel üç farklı görünüm hazırlıyoruz. Birini seçiyorsunuz, gerisi ona göre ilerliyor.' },
  { t: 'Günler içinde yayında', d: 'Haftalar değil, günler. Her aşamanın önce ve sonrasını size açıkça gösteriyoruz.' },
  { t: 'Her ay değer defteri', d: 'Kaç kişi baktı, kaç kişi aradı, kaç mesaj geldi: her ay tek sayfada, sayılarla.' },
];

const packages = [
  { n: 'Vitrin Site', who: 'Sitesi olmayan ya da eskiyen işletme', items: ['Telefonda hızlı açılan tek sayfa site', 'Menü, hizmet, saat ve konum', 'Google İşletme Profili düzenlemesi', 'WhatsApp ve arama butonu'] },
  { n: 'Vitrin + Sosyal', who: 'Instagram\'ı dağınık olan işletme', items: ['Vitrin Site\'deki her şey', 'Aylık içerik planı ve paylaşımlar', 'Sitenizle aynı görsel dil', 'Aylık değer defteri'], hl: true },
  { n: 'Büyüme', who: 'Daha çok müşteri isteyen işletme', items: ['Vitrin + Sosyal\'deki her şey', 'Instagram ve Google reklam yönetimi', 'Mesajlara otomatik ilk cevap', 'Reklamın getirdiğini gösteren rapor'] },
];

const faqs = [
  { q: 'Ücretsiz dijital check-up tam olarak ne?', a: 'Sitenize, Google İşletme Profilinize, Instagram hesabınıza ve varsa reklam hesabınıza bakıyoruz. Neyin çalıştığını, neyin müşteri kaçırdığını tek sayfalık bir raporla WhatsApp\'tan gönderiyoruz. Ücret yok, bağlayıcılığı yok.' },
  { q: '"Günler içinde" ne kadar sürüyor?', a: 'Tek sayfa vitrin sitesi, içerikleriniz (menü, fotoğraf, saatler) hazırsa genellikle birkaç iş günü içinde yayında olur. Kesin süreyi görüşmeden sonra yazılı olarak veriyoruz.' },
  { q: 'Fiyatlar neden sitede yok?', a: 'Bir kafeyle çok şubeli bir kliniğin ihtiyacı aynı değil. Görüşmeden sonra 24 saat içinde işletmenize göre net, kalem kalem teklif gönderiyoruz. Sürpriz ücret yok.' },
  { q: 'Yapay zekâ kullanıyorsunuz, site "hazır şablon" gibi mi olacak?', a: 'Hayır. Yapay zekâyı üretimi hızlandırmak için kullanıyoruz; tasarım yönünü, metinleri ve son kontrolü biz yapıyoruz. Her işletme kendi renkleri ve kendi diliyle çıkar.' },
  { q: 'Fotoğrafım, logom yok. Yine de olur mu?', a: 'Olur. Telefonla nasıl çekeceğinizi anlatan kısa bir rehber veriyoruz, logo ve renk seçimini birlikte netleştiriyoruz. Stok fotoğrafla sizi başkasına benzetmiyoruz.' },
  { q: 'Site ve hesaplar kimin üzerine olacak?', a: 'Alan adı, site ve sosyal medya hesapları sizin adınıza kalır. Bizimle çalışmayı bıraksanız da her şey sizde kalır.' },
];
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0E1512" media="(prefers-color-scheme: dark)" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="tr_TR" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230E1512'/%3E%3Cpath d='M8 9l8 15 8-15' stroke='%23D7381E' stroke-width='4' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400;100..125,500;100..125,800&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'ProfessionalService', name: site.brand, description, areaServed: 'TR', email: site.email })} />
</head>
<body>
  <a href="#icerik" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:bg-bg focus:px-4 focus:py-2 focus:rounded-[8px]">İçeriğe geç</a>

  <!-- 1. NAV -->
  <header class="nav fixed inset-x-0 top-0 z-50" id="nav">
    <div class="wrap flex h-16 items-center justify-between gap-6">
      <a href="#" class="flex items-center gap-2.5 font-extrabold tracking-[-0.02em] text-[18px] whitespace-nowrap" style="font-stretch:112%" aria-label={`${site.brand} ana sayfa`}>
        <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--foreground)"/><path d="M8 9l8 15 8-15" stroke="var(--primary)" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {site.brand}
      </a>
      <nav class="hidden lg:flex items-center gap-8" aria-label="Ana menü">
        <a class="nav-link" href="#hizmetler">Hizmetler</a>
        <a class="nav-link" href="#nasil">Nasıl çalışır</a>
        <a class="nav-link" href="#paketler">Paketler</a>
        <a class="nav-link" href="#sss">SSS</a>
      </nav>
      <div class="flex items-center gap-2">
        <a href={waLink} target="_blank" rel="noopener" class="btn btn-primary btn-sm max-sm:!w-11 max-sm:!px-0" aria-label="WhatsApp'tan yazın"><Fragment set:html={I('wa', 'icon !w-4 !h-4')} /><span class="max-sm:sr-only">WhatsApp</span></a>
        <details class="mnav lg:hidden relative">
          <summary class="grid place-items-center w-11 h-11 rounded-full border border-line" aria-label="Menüyü aç">
            <Fragment set:html={I('menu', 'icon ic-menu')} /><Fragment set:html={I('x', 'icon ic-x')} />
          </summary>
          <div class="mnav-panel absolute right-0 top-14 w-60 rounded-[14px] border border-line bg-bg p-2">
            <a class="block rounded-[8px] px-4 py-3 font-medium hover:bg-surface" href="#hizmetler">Hizmetler</a>
            <a class="block rounded-[8px] px-4 py-3 font-medium hover:bg-surface" href="#nasil">Nasıl çalışır</a>
            <a class="block rounded-[8px] px-4 py-3 font-medium hover:bg-surface" href="#paketler">Paketler</a>
            <a class="block rounded-[8px] px-4 py-3 font-medium hover:bg-surface" href="#sss">SSS</a>
          </div>
        </details>
      </div>
    </div>
  </header>

  <main id="icerik">
    <!-- 2. HERO -->
    <section class="relative pt-32 pb-24 lg:pt-40 lg:pb-32">
      <div class="wrap grid lg:grid-cols-12 gap-16 lg:gap-6 items-center">
        <div class="lg:col-span-7">
          <p class="eyebrow hero-fade mb-6">Restoran, kafe, berber, klinik ve butikler için</p>
          <h1 class="t-display max-w-[11ch]">
            {words.map((w, i) => (
              <><span class="hw"><span style={`--i:${i}`} class={w === 'günler' ? 'text-primary' : ''}>{w}</span></span>{' '}</>
            ))}
          </h1>
          <p class="t-lead text-muted mt-8 max-w-[34rem] hero-fade">Web sitesi, mobil uygulama, sosyal medya ve reklam tek yerden. Yapay zekâ destekli üretim hattımızla ajans kalitesinde işi haftalar değil, günler içinde teslim ediyoruz.</p>
          <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-4 hero-fade">
            <a href={waLink} target="_blank" rel="noopener" class="btn btn-primary"><Fragment set:html={I('wa', 'icon !w-4 !h-4')} />Ücretsiz dijital check-up iste</a>
            <span class="t-small text-muted max-w-[22rem]">Sitenize, Google profilinize ve Instagram'ınıza bakıp 1 sayfalık rapor gönderiyoruz.</span>
          </div>
        </div>

        <!-- Cihazlar: tarayıcı + telefon, örnek kafe sitesi -->
        <div class="lg:col-span-5 devices hero-fade" id="devices" aria-label="Örnek kafe sitesi önizlemesi" role="img">
          <div class="stage relative mx-auto max-w-[520px] pb-10 pr-10 sm:pr-16">
            <div class="device-shadow rounded-[14px] border border-line bg-bg overflow-hidden">
              <div class="flex items-center gap-1.5 px-3 h-8 bg-surface border-b border-line">
                <span class="w-2.5 h-2.5 rounded-full bg-line"></span><span class="w-2.5 h-2.5 rounded-full bg-line"></span><span class="w-2.5 h-2.5 rounded-full bg-line"></span>
                <span class="ml-3 h-4 flex-1 max-w-[180px] rounded-full bg-bg border border-line"></span>
              </div>
              <div class="p-5 sm:p-6" style="background:#F6EFE6;color:#3B2618">
                <div class="flex justify-between items-center text-[10px] font-medium opacity-80"><span class="font-extrabold text-[12px]" style="font-stretch:112%">Köşe Kahve</span><span class="flex gap-3"><span>Menü</span><span>Saatler</span><span>Konum</span></span></div>
                <div class="mt-6 grid grid-cols-5 gap-4 items-end">
                  <div class="col-span-3">
                    <div class="font-extrabold leading-[.95] tracking-[-0.03em] text-[26px] sm:text-[30px]" style="font-stretch:112%">Sabah 7'de demlenen kahve.</div>
                    <div class="mt-3 text-[10px] opacity-70 leading-snug">Kadıköy · Her gün 07:00–22:00</div>
                    <div class="mt-4 inline-flex h-6 items-center rounded-full px-3 text-[10px] font-medium" style="background:#3B2618;color:#F6EFE6">Masa ayırt</div>
                  </div>
                  <div class="col-span-2 aspect-[3/4] rounded-[10px] relative overflow-hidden" style="background:#8A5A3B">
                    <svg viewBox="0 0 60 80" class="absolute inset-0 w-full h-full" aria-hidden="true"><ellipse cx="30" cy="52" rx="18" ry="6" fill="#5C3A24"/><path d="M14 36h32v10a16 12 0 0 1-32 0z" fill="#F6EFE6"/><path d="M46 39h4a4 4 0 0 1 0 8h-4" stroke="#F6EFE6" stroke-width="2.5" fill="none"/><path d="M24 22c0 4 4 4 4 8M32 20c0 4 4 4 4 8" stroke="#F6EFE6" stroke-width="2" fill="none" stroke-linecap="round" opacity=".7"/></svg>
                  </div>
                </div>
                <div class="mt-5 grid grid-cols-3 gap-2 text-[9px]">
                  <div class="rounded-[6px] p-2" style="background:#EADBC8">Filtre kahve<div class="font-bold mt-1">Menüde</div></div>
                  <div class="rounded-[6px] p-2" style="background:#EADBC8">Cheesecake<div class="font-bold mt-1">Menüde</div></div>
                  <div class="rounded-[6px] p-2" style="background:#EADBC8">Kahvaltı<div class="font-bold mt-1">Menüde</div></div>
                </div>
              </div>
            </div>
            <!-- telefon -->
            <div class="device-shadow absolute right-0 bottom-0 w-[38%] max-w-[180px] rounded-[26px] border-[5px] border-[#0E1512] bg-[#0E1512] overflow-hidden">
              <div class="rounded-[20px] overflow-hidden" style="background:#F6EFE6;color:#3B2618">
                <div class="h-4 flex justify-center pt-1"><span class="w-10 h-1.5 rounded-full bg-[#0E1512]"></span></div>
                <div class="px-3 pb-4 pt-2">
                  <div class="font-extrabold text-[9px]" style="font-stretch:112%">Köşe Kahve</div>
                  <div class="mt-3 font-extrabold leading-[.95] tracking-[-0.03em] text-[16px]" style="font-stretch:112%">Sabah 7'de demlenen kahve.</div>
                  <div class="mt-3 aspect-square rounded-[8px]" style="background:#8A5A3B"></div>
                  <div class="mt-3 h-6 rounded-full grid place-items-center text-[8px] font-medium" style="background:#3B2618;color:#F6EFE6">WhatsApp'tan yaz</div>
                  <div class="mt-2 h-6 rounded-full grid place-items-center text-[8px] font-medium border" style="border-color:#3B2618">Yol tarifi</div>
                </div>
              </div>
            </div>
            <span class="absolute left-3 -bottom-1 t-small text-muted">Örnek konsept</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. SEKTÖR ŞERİDİ -->
    <section class="border-y border-line py-6 bg-surface" aria-label="Çalıştığımız sektörler">
      <div class="marquee overflow-hidden">
        <ul class="marquee-track" aria-hidden="false">
          {[...sectors, ...sectors].map((s, i) => (
            <li class="flex items-center gap-8 pr-8 font-extrabold text-[22px] lg:text-[28px] tracking-[-0.015em] whitespace-nowrap" style="font-stretch:112%" aria-hidden={i >= sectors.length ? 'true' : undefined}>
              {s}<span class="w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. DERTLER -->
    <section class="section" aria-labelledby="dertler-h">
      <div class="wrap grid lg:grid-cols-12 gap-12 lg:gap-6">
        <div class="lg:col-span-4">
          <p class="eyebrow mb-5">Tanıdık geldi mi?</p>
          <h2 id="dertler-h" class="t-h2">Müşteri sizi arıyor, bulamıyor.</h2>
          <p class="t-lead text-muted mt-6 max-w-[26rem]">İşletmeler en çok bu üç yerde müşteri kaybediyor. Üçü de bir haftada çözülebilir.</p>
        </div>
        <ol class="lg:col-span-7 lg:col-start-6">
          {pains.map((p, i) => (
            <li class="pain py-8 lg:py-10 grid grid-cols-[auto_1fr] gap-x-5 gap-y-3" data-reveal>
              <span class="text-primary pt-1" set:html={I(p.icon as keyof typeof ic, 'icon !w-6 !h-6')} />
              <div class="pain-body">
                <h3 class="t-h3">{p.d}</h3>
                <p class="text-muted mt-3 max-w-[36rem]">{p.s}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. HİZMETLER (bento) -->
    <section id="hizmetler" class="section bg-surface" aria-labelledby="hizmet-h">
      <div class="wrap">
        <div class="max-w-[40rem]">
          <p class="eyebrow mb-5">Hizmetler</p>
          <h2 id="hizmet-h" class="t-h2">Hepsi tek yerden, aynı tasarım dilinde.</h2>
        </div>
        <div class="mt-12 lg:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- Web: büyük -->
          <article class="svc card lg:col-span-7 overflow-hidden flex flex-col">
            <div class="flex items-center gap-3 text-muted"><Fragment set:html={I('globe')} /><span class="t-small">Web sitesi</span></div>
            <h3 class="t-h3 mt-4 max-w-[22ch]">Telefonda hızlı açılan, Google'da bulunan site.</h3>
            <p class="text-muted mt-3 max-w-[36rem]">Menü, hizmetler, saatler, konum ve tek dokunuşla WhatsApp. Şehir ve hizmet adıyla aranacak şekilde kurulur.</p>
            <div class="peek mt-8 -mb-10 lg:-mb-12 rounded-t-[14px] border border-line border-b-0 bg-surface p-4">
              <div class="flex gap-1.5 mb-3"><span class="w-2 h-2 rounded-full bg-line"></span><span class="w-2 h-2 rounded-full bg-line"></span><span class="w-2 h-2 rounded-full bg-line"></span></div>
              <div class="grid grid-cols-3 gap-3">
                <div class="col-span-2 space-y-2"><div class="h-4 w-4/5 rounded bg-fg/80"></div><div class="h-4 w-3/5 rounded bg-fg/80"></div><div class="h-2 w-full rounded bg-line mt-3"></div><div class="h-2 w-4/5 rounded bg-line"></div><div class="h-6 w-24 rounded-full bg-primary mt-3"></div></div>
                <div class="rounded-[8px] bg-line"></div>
              </div>
            </div>
          </article>
          <!-- Uygulama -->
          <article class="svc card lg:col-span-5 flex flex-col">
            <div class="flex items-center gap-3 text-muted"><Fragment set:html={I('smartphone')} /><span class="t-small">Mobil uygulama</span></div>
            <h3 class="t-h3 mt-4">Markanıza özel uygulama.</h3>
            <p class="text-muted mt-3">Sadakat kartı, randevu, sipariş. Müdavimleriniz telefonunda sizi taşısın.</p>
            <div class="peek mt-auto pt-8 flex justify-center">
              <div class="w-32 rounded-[20px] border-[4px] border-fg p-2.5 bg-bg">
                <div class="h-2 w-10 mx-auto rounded-full bg-line"></div>
                <div class="mt-3 rounded-[8px] bg-surface border border-line p-2">
                  <div class="text-[8px] font-medium text-muted">Sadakat kartı</div>
                  <div class="mt-1.5 grid grid-cols-5 gap-1">{Array.from({length:10}).map((_, k) => <span class={`aspect-square rounded-full ${k < 6 ? 'bg-primary' : 'border border-line'}`}></span>)}</div>
                </div>
                <div class="mt-2 h-5 rounded-full bg-fg"></div>
              </div>
            </div>
          </article>
          <!-- Sosyal -->
          <article class="svc card lg:col-span-5 flex flex-col">
            <div class="flex items-center gap-3 text-muted"><Fragment set:html={I('layout')} /><span class="t-small">Sosyal medya</span></div>
            <h3 class="t-h3 mt-4">Dağınık değil, düzenli bir Instagram.</h3>
            <p class="text-muted mt-3">Aylık içerik planı, paylaşımlar ve hikâyeler. Sitenizle aynı renk ve dil.</p>
            <div class="peek mt-8 grid grid-cols-3 gap-1.5 max-w-[220px]">
              {['bg-fg','bg-line','bg-primary','bg-line','bg-fg/70','bg-line','bg-primary/70','bg-line','bg-fg'].map(c => <span class={`aspect-square rounded-[4px] ${c}`}></span>)}
            </div>
          </article>
          <!-- Reklam -->
          <article class="svc card lg:col-span-7 flex flex-col">
            <div class="flex items-center gap-3 text-muted"><Fragment set:html={I('megaphone')} /><span class="t-small">Reklam ve otomatik cevap</span></div>
            <h3 class="t-h3 mt-4 max-w-[24ch]">Reklama verilen paranın nereye gittiğini görün.</h3>
            <p class="text-muted mt-3 max-w-[36rem]">Instagram ve Google reklamları, gelen mesajlara otomatik ilk cevap, her ay reklamın getirdiğini gösteren rapor.</p>
            <div class="peek mt-8 space-y-2 max-w-[340px]">
              <div class="rounded-[14px] rounded-bl-[4px] bg-surface border border-line px-3 py-2 text-[13px] w-fit">Yarın 14:00'e yer var mı?</div>
              <div class="rounded-[14px] rounded-br-[4px] bg-fg text-bg px-3 py-2 text-[13px] w-fit ml-auto">Merhaba! Yarın 14:00 müsait. Adınızı yazar mısınız?</div>
              <div class="t-small text-muted text-right">Otomatik ilk cevap · örnek</div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 6. NASIL ÇALIŞIYORUZ -->
    <section id="nasil" class="section" aria-labelledby="nasil-h">
      <div class="wrap">
        <div class="max-w-[40rem]">
          <p class="eyebrow mb-5">Nasıl çalışıyoruz</p>
          <h2 id="nasil-h" class="t-h2">Dört adım, sürpriz yok.</h2>
        </div>
        <div class="steps relative mt-12 lg:mt-20" id="steps">
          <div class="absolute bg-line left-[5px] top-2 bottom-2 w-[2px] lg:left-0 lg:right-0 lg:top-[5px] lg:bottom-auto lg:w-auto lg:h-[2px]" aria-hidden="true">
            <div class="steps-bar absolute inset-0 bg-primary"></div>
          </div>
          <ol class="grid gap-10 lg:grid-cols-4 lg:gap-6">
            {steps.map((s, i) => (
              <li class="relative pl-10 lg:pl-0 lg:pt-12">
                <span class="absolute left-0 top-1.5 lg:top-0 w-3 h-3 rounded-full bg-bg border-2 border-primary" aria-hidden="true"></span>
                <span class="t-small text-muted">Adım {i + 1}</span>
                <h3 class="t-h3 mt-2">{s.t}</h3>
                <p class="text-muted mt-3 max-w-[28rem]">{s.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 7. ÖRNEK KONSEPTLER -->
    <section class="section bg-surface" aria-labelledby="konsept-h">
      <div class="wrap">
        <div class="grid lg:grid-cols-12 gap-6 items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow mb-5">Örnek konseptler</p>
            <h2 id="konsept-h" class="t-h2">Her işletme kendi rengiyle.</h2>
          </div>
          <p class="lg:col-span-5 text-muted">Bunlar gerçek müşteri işi değil; üretim hattımızın nasıl farklı sonuçlar çıkardığını göstermek için hazırladığımız örnek konseptler.</p>
        </div>
        <div class="mt-12 lg:mt-16 grid gap-6 lg:grid-cols-12">
          <!-- Kafe -->
          <figure class="concept lg:col-span-5 lg:row-span-2">
            <div class="mini rounded-[24px] p-6 lg:p-8 h-full min-h-[340px] flex flex-col" style="background:#F6EFE6;color:#3B2618">
              <span class="t-small opacity-70">Kafe</span>
              <ul class="mt-6 text-[14px] divide-y" style="border-color:#E2D3BF">
                {[['Filtre kahve','Günün çekirdeği'],['Türk kahvesi','Közde'],['Cheesecake','Ev yapımı']].map(([a,b]) => <li class="flex justify-between py-2.5" style="border-color:#E2D3BF"><span class="font-medium">{a}</span><span class="opacity-70">{b}</span></li>)}
              </ul>
              <div class="mt-auto pt-10 font-extrabold text-[40px] lg:text-[52px] leading-[.95] tracking-[-0.035em]" style="font-stretch:112%">Sabah 7'de demlenen kahve.</div>
              <div class="mt-6 flex gap-2"><span class="h-8 px-4 rounded-full grid place-items-center text-[13px] font-medium" style="background:#3B2618;color:#F6EFE6">Menüye bak</span><span class="h-8 px-4 rounded-full grid place-items-center text-[13px] font-medium border" style="border-color:#3B2618">Yol tarifi</span></div>
            </div>
            <figcaption class="mt-3 t-small text-muted">Örnek konsept · Köşe Kahve</figcaption>
          </figure>
          <!-- Berber -->
          <figure class="concept lg:col-span-7">
            <div class="mini rounded-[24px] p-6 lg:p-8 min-h-[200px] grid grid-cols-[1fr_auto] gap-6 items-end" style="background:#141414;color:#E9DFC6">
              <div>
                <span class="t-small" style="color:#C9A45C">Berber</span>
                <div class="mt-6 font-extrabold text-[30px] lg:text-[38px] leading-[.95] tracking-[-0.03em]" style="font-stretch:125%">Usta Makas.<br/>Randevusuz bekleme yok.</div>
              </div>
              <div class="hidden sm:grid gap-1.5 text-[12px]">
                {['10:00','11:30','14:00'].map((h, k) => <span class="h-8 px-4 rounded-full grid place-items-center font-medium" style={k===1 ? 'background:#C9A45C;color:#141414' : 'border:1px solid #C9A45C;color:#E9DFC6'}>{h}</span>)}
              </div>
            </div>
            <figcaption class="mt-3 t-small text-muted">Örnek konsept · Usta Makas</figcaption>
          </figure>
          <!-- Klinik -->
          <figure class="concept lg:col-span-7">
            <div class="mini rounded-[24px] p-6 lg:p-8 min-h-[200px] grid sm:grid-cols-[1fr_auto] gap-6 items-end" style="background:#E8F1F6;color:#0F2A3A">
              <div>
                <span class="t-small opacity-70">Klinik</span>
                <div class="mt-6 font-extrabold text-[30px] lg:text-[38px] leading-[1] tracking-[-0.03em]" style="font-stretch:100%">Diş tedavisinde<br/>önce net bilgi.</div>
              </div>
              <div class="rounded-[14px] bg-white/70 p-4 text-[12px] space-y-1.5 min-w-[180px]">
                <div class="font-bold">Randevu al</div>
                <div class="h-7 rounded-[8px] border border-[#BFD6E3] bg-white"></div>
                <div class="h-7 rounded-[8px] grid place-items-center font-medium text-white" style="background:#0F5C80">Gönder</div>
              </div>
            </div>
            <figcaption class="mt-3 t-small text-muted">Örnek konsept · Nefes Diş</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 8. DEĞER DEFTERİ -->
    <section class="section" aria-labelledby="defter-h">
      <div class="wrap grid lg:grid-cols-12 gap-12 lg:gap-6 items-center">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-5">Değer defteri</p>
          <h2 id="defter-h" class="t-h2">Her ay, sayılarla.</h2>
          <p class="t-lead text-muted mt-6">"Bu ay ne yaptınız?" diye sormanıza gerek kalmaz. Her ayın sonunda sitenize kaç kişinin baktığını, kaç kişinin aradığını ve kaç mesaj geldiğini tek sayfada gönderiyoruz.</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="ledger rounded-[24px] p-6 lg:p-8" style="background:var(--ink);color:var(--ink-foreground)" data-reveal>
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="t-small" style="color:var(--ink-muted)">Örnek rapor · Köşe Kahve</div>
                <div class="t-h3 mt-1">Ekim ayı değer defteri</div>
              </div>
              <span class="t-small rounded-full px-3 py-1 border" style="border-color:var(--ink-border);color:var(--ink-muted)">Örnek</span>
            </div>
            <svg viewBox="0 0 300 110" class="mt-8 w-full h-auto" aria-hidden="true">
              <g stroke="var(--ink-border)" stroke-width="1"><line x1="0" y1="20" x2="300" y2="20"/><line x1="0" y1="55" x2="300" y2="55"/><line x1="0" y1="90" x2="300" y2="90"/></g>
              <polyline class="ledger-line" points="0,88 43,82 86,84 129,70 172,62 215,48 258,40 300,26" fill="none" stroke="#FF5A3C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <circle class="ledger-dot" cx="300" cy="26" r="5" fill="#FF5A3C"/>
            </svg>
            <div class="flex justify-between t-small mt-2" style="color:var(--ink-muted)"><span>1. hafta</span><span>4. hafta</span></div>
            <dl class="mt-8 grid grid-cols-3 gap-4 border-t pt-6" style="border-color:var(--ink-border)">
              <div><dt class="t-small" style="color:var(--ink-muted)">Siteye bakan</dt><dd class="t-h3 mt-1">— kişi</dd></div>
              <div><dt class="t-small" style="color:var(--ink-muted)">Arama</dt><dd class="t-h3 mt-1">— adet</dd></div>
              <div><dt class="t-small" style="color:var(--ink-muted)">WhatsApp mesajı</dt><dd class="t-h3 mt-1">— adet</dd></div>
            </dl>
            <p class="t-small mt-6" style="color:var(--ink-muted)">Gerçek raporda bu alanlar işletmenizin sayılarıyla dolar. Burada uydurma rakam göstermiyoruz.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 9. PAKETLER -->
    <section id="paketler" class="section bg-surface" aria-labelledby="paket-h">
      <div class="wrap">
        <div class="grid lg:grid-cols-12 gap-6 items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow mb-5">Paketler</p>
            <h2 id="paket-h" class="t-h2">İşletmenize göre fiyat, 24 saatte net teklif.</h2>
          </div>
          <p class="lg:col-span-5 text-muted">Liste fiyatı yok, çünkü her işletmenin ihtiyacı farklı. Check-up'tan sonra kalem kalem yazılı teklif gönderiyoruz.</p>
        </div>
        <div class="mt-12 lg:mt-16 grid gap-6 lg:grid-cols-[1fr_1.15fr_1fr]">
          {packages.map(p => (
            <article class={`card flex flex-col ${p.hl ? 'lg:-my-4 !border-fg' : ''}`}>
              {p.hl && <span class="t-small text-primary mb-3">Önerdiğimiz başlangıç</span>}
              <h3 class="t-h3">{p.n}</h3>
              <p class="text-muted mt-2">{p.who}</p>
              <ul class="mt-6 space-y-3 border-t border-line pt-6">
                {p.items.map(it => <li class="flex gap-3"><span class="text-success mt-0.5" set:html={I('check')} />{it}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="mt-6 card !bg-transparent flex flex-col lg:flex-row lg:items-center gap-6 justify-between">
          <div class="flex gap-4 items-start">
            <span class="text-muted mt-1" set:html={I('smartphone', 'icon !w-6 !h-6')} />
            <div>
              <h3 class="t-h3">Markaya özel uygulama</h3>
              <p class="text-muted mt-2 max-w-[40rem]">Sadakat kartı, randevu ya da sipariş isteyen işletmeler için. Paketlerin üzerine eklenir.</p>
            </div>
          </div>
          <a href={waLink} target="_blank" rel="noopener" class="btn btn-secondary shrink-0">Uygulama için teklif al</a>
        </div>
      </div>
    </section>

    <!-- 10. SSS -->
    <section id="sss" class="section" aria-labelledby="sss-h">
      <div class="wrap grid lg:grid-cols-12 gap-12 lg:gap-6">
        <div class="lg:col-span-4">
          <p class="eyebrow mb-5">SSS</p>
          <h2 id="sss-h" class="t-h2">Aklınızdaki sorular.</h2>
          <p class="text-muted mt-6">Burada olmayan bir şey mi var? <a href={waLink} target="_blank" rel="noopener" class="underline underline-offset-4 text-fg">WhatsApp'tan sorun</a>.</p>
        </div>
        <div class="faq lg:col-span-7 lg:col-start-6 border-t border-line">
          {faqs.map(f => (
            <details class="border-b border-line">
              <summary class="flex items-start justify-between gap-6 py-6 min-h-[44px]">
                <span class="font-medium text-[18px] lg:text-[19px] leading-snug">{f.q}</span>
                <span class="plus text-muted mt-0.5" set:html={I('plus')} />
              </summary>
              <div class="ans"><div class="overflow-hidden"><p class="text-muted pb-6 max-w-[40rem]">{f.a}</p></div></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 11. SON CTA -->
    <section class="px-3 sm:px-5 pb-3 sm:pb-5" aria-labelledby="cta-h">
      <div class="rounded-[24px] text-center py-24 lg:py-32 px-5" style="background:var(--ink);color:var(--ink-foreground)">
        <h2 id="cta-h" class="t-h2 max-w-[16ch] mx-auto">Önce bakalım, sonra konuşalım.</h2>
        <p class="t-lead mt-6 max-w-[34rem] mx-auto" style="color:var(--ink-muted)">İşletmenizin dijital halini ücretsiz inceleyip 1 sayfalık rapor gönderelim. Beğenmezseniz hiçbir şey borçlu değilsiniz.</p>
        <a href={waLink} target="_blank" rel="noopener" class="btn btn-primary mt-10"><Fragment set:html={I('wa', 'icon !w-4 !h-4')} />Ücretsiz dijital check-up iste</a>
      </div>
    </section>
  </main>

  <footer class="wrap py-12 lg:py-16 grid gap-10 lg:grid-cols-12 text-[15px]">
    <div class="lg:col-span-5">
      <div class="font-extrabold text-[18px]" style="font-stretch:112%">{site.brand}</div>
      <p class="text-muted mt-3 max-w-[26rem]">Yerel işletmelere web sitesi, uygulama, sosyal medya ve reklam. Türkiye geneli, uzaktan.</p>
    </div>
    <ul class="lg:col-span-4 space-y-1">
      <li><a class="inline-flex items-center gap-3 min-h-[44px] hover:text-primary" href={waLink} target="_blank" rel="noopener"><Fragment set:html={I('wa')} />WhatsApp'tan yazın</a></li>
      <li><a class="inline-flex items-center gap-3 min-h-[44px] hover:text-primary" href={telLink}><Fragment set:html={I('phone')} />Bizi arayın</a></li>
      <li><a class="inline-flex items-center gap-3 min-h-[44px] hover:text-primary" href={mailLink}><Fragment set:html={I('mail')} />{site.email}</a></li>
      <li><a class="inline-flex items-center gap-3 min-h-[44px] hover:text-primary" href={igLink} target="_blank" rel="noopener"><Fragment set:html={I('insta')} />@{site.instagram}</a></li>
    </ul>
    <div class="lg:col-span-3 t-small text-muted space-y-3 font-normal">
      <p>Bu site çerez kullanmaz, ziyaretçi takibi yapmaz.</p>
      <p>WhatsApp'tan paylaştığınız bilgiler yalnızca size teklif ve rapor hazırlamak için, KVKK'ya uygun şekilde kullanılır.</p>
      <p>© {new Date().getFullYear()} {site.brand}</p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var nav = document.getElementById('nav');
      var devices = document.getElementById('devices');
      var steps = document.getElementById('steps');
      var bar = steps && steps.querySelector('.steps-bar');
      var ticking = false;
      function onScroll() {
        var y = window.scrollY;
        nav.classList.toggle('is-scrolled', y > 8);
        if (!reduce && devices) {
          var t = Math.max(0, 6 - y / 80);
          devices.style.setProperty('--tilt', t.toFixed(2) + 'deg');
        }
        if (!reduce && bar) {
          var r = steps.getBoundingClientRect();
          var vh = window.innerHeight;
          var p = (vh * 0.8 - r.top) / (r.height + vh * 0.3);
          bar.parentNode.style.setProperty('--p', Math.min(1, Math.max(0, p)).toFixed(3));
        }
        ticking = false;
      }
      window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
      onScroll();
      var els = document.querySelectorAll('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('is-in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -12% 0px' });
      els.forEach(function (e) { io.observe(e); });
      // mobil menü: linke tıklayınca kapan
      document.querySelectorAll('.mnav a').forEach(function (a) { a.addEventListener('click', function () { a.closest('details').removeAttribute('open'); }); });
    })();
  </script>
</body>
</html>
