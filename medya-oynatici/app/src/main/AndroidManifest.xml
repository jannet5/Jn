<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- YouTube'dan indirmek için internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Arka planda çalma ve indirme için ön plan servisi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- İndirme ilerlemesini bildirimde göstermek için -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ekran kapalıyken indirme/çalma sürsün -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".OynaticiApp"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Oynatici">

        <!-- Tek ekranlı uygulama; YouTube'dan "Paylaş" ile link de alır -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Müzik/video çalan servis (ekran kapalıyken de çalar, bildirimde kontroller) -->
        <service
            android:name=".oynat.CalmaServisi"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- YouTube indirmelerini yürüten servis -->
        <service
            android:name=".indir.IndirmeServisi"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
