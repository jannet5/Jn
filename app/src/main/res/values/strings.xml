    <string name="privacy_title">Your messages stay here</string>
    <string name="privacy_body">TekPanel only reads notifications of the apps you pick, and keeps them in a private store on this phone. It has no internet permission, so it cannot send your messages anywhere. You can turn access off any time in Android settings.</string>

    <string name="erase_all_confirm_title">Delete all data?</string>
    <string name="erase_all_confirm_message">This permanently deletes every message TekPanel stored on this phone and resets your channel choices. It cannot be undone.</string>
    <string name="export_share_title">Export TekPanel data</string>

