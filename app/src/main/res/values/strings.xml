    <string name="access_title">Turn on notification access</string>
    <string name="access_body">That is how messages reach this screen. They stay on this phone.</string>
    <string name="access_open">Open access settings</string>
    <string name="access_howto">How?</string>
    <string name="guide_title">Turning on notification access</string>
    <string name="guide_why">Android only lets an app read notifications after you allow it once. It takes about 20 seconds.</string>
    <string name="guide_step1">Tap \"Open access settings\". Android opens the right page.</string>
    <string name="guide_step2">Find TekPanel in the list and switch it on.</string>
    <string name="guide_step3">When Android asks, tap \"Allow\".</string>
    <string name="guide_step4">Switch is grey and won\'t move? Android locks it for apps installed outside Google Play. Open App info, tap the three dots at the top right, choose \"Allow restricted settings\", then repeat step 2.</string>
