<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy (pre-API 31) backup rule, mirrors data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="database" path="." />
    <exclude domain="database" path="sende_inbox.db" />
    <exclude domain="database" path="sende_inbox.db-shm" />
    <exclude domain="database" path="sende_inbox.db-wal" />
    <exclude domain="database" path="sende_inbox.db-journal" />
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
    <exclude domain="file" path="media/" />
</full-backup-content>
