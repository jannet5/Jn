<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Debug builds only: lets the instrumented test post a notification from this app itself on
        Android 13+. The release manifest still carries no notification permission at all.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
