<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/item_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/plex_medium"
        android:maxLines="2"
        android:paddingBottom="12dp"
        android:textColor="@color/ink"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/every_switch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/remind_every_label"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/every_min"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:labelFor="@id/every_min"
            android:text="@string/remind_every_suffix"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="@string/remind_every_hint"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/at_switch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/remind_at_label"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/at_time"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/exact_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:text="@string/remind_exact_hint"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notif_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/remind_notif_off"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
